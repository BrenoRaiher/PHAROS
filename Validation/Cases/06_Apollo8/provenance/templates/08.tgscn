format = "TGSCN"
format_version = 1
generator = "Apollo 8-like continuous validation, 2026-08-25"

[scenario]
name = "Apollo 8-like 08_lunar_orbit_circularization_controlled_maneuver"
start_utc = "1968-12-24T14:25:06.600Z"
end_mode = "final_utc"
final_utc = "1968-12-24T14:26:17.020Z"
integrator = "adaptive_dormand_prince_54"
maximum_integrator_step_seconds = 0.25
initial_integrator_step_seconds = 0.10000000000000001
