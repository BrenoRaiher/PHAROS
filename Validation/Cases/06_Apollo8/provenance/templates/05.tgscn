angular_velocity_body_radps = [3.2175344527578209e-08, -4.5885140287070606e-06, 7.5317913023219585e-06]

[[components]]
id = "a8000001-0000-0000-0000-000000000001"
name = "Apollo 8 CSM dry structure"
initial_mass_kg = 13000
minimum_mass_kg = 13000
variable_mass = false
local_center_of_mass_m = [0.0, 0.0, 0.0]
