format = "TGSCN"
format_version = 1
generator = "Apollo 8-like continuous validation, 2026-08-25"

[scenario]
name = "Apollo 8-like 03_translunar_coast_to_second_midcourse_attitude_start"
start_utc = "1968-12-21T23:52:01.900Z"
end_mode = "final_utc"
final_utc = "1968-12-24T01:49:55.000Z"
integrator = "adaptive_dormand_prince_54"
maximum_integrator_step_seconds = 20
initial_integrator_step_seconds = 0.10000000000000001
absolute_tolerance = 1.0e-5
relative_tolerance = 1.0e-12
output_mode = "fixed_interval"
output_step_seconds = 300
maximum_integration_steps = 5000000
maximum_output_samples = 1000000
mass_flow_convention = "thrust_includes_exhaust_momentum"

[initial_state]
position_icrf_m = [-916374080.81608641, 134904868088.55562, 58514239145.187363]
velocity_icrf_mps = [-27988.331527472306, -1277.0340023183758, -594.74337323121802]
attitude_body_to_icrf = [0.47727053039292905, -0.30621080547076629, -0.3636615622674278, 0.73905213047565899]
angular_velocity_body_radps = [3.6080169945692811e-06, 0.00022392912544701578, -0.00024861901693582465]

[[components]]
id = "a8000001-0000-0000-0000-000000000001"
name = "Apollo 8 CSM dry structure"
initial_mass_kg = 13000
minimum_mass_kg = 13000
variable_mass = false
local_center_of_mass_m = [0.0, 0.0, 0.0]
origin_body_m = [0.0, 0.0, 0.0]
component_to_body = [1.0, 0.0, 0.0, 0.0]
parent_component = ""
