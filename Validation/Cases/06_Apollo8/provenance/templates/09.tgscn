format = "TGSCN"
format_version = 1
generator = "Apollo 8-like continuous validation, 2026-08-25"

[scenario]
name = "Apollo 8-like 09_lunar_orbit_to_transearth_injection_attitude_start"
start_utc = "1968-12-24T14:26:17.020Z"
end_mode = "final_utc"
final_utc = "1968-12-25T06:09:16.600Z"
integrator = "adaptive_dormand_prince_54"
maximum_integrator_step_seconds = 20
initial_integrator_step_seconds = 0.10000000000000001
absolute_tolerance = 1.0e-5
relative_tolerance = 1.0e-12
output_mode = "fixed_interval"
output_step_seconds = 300
maximum_integration_steps = 5000000
maximum_output_samples = 1000000
mass_flow_convention = "thrust_includes_exhaust_momentum"

[initial_state]
position_icrf_m = [-7464109844.2705965, 134612178014.67097, 58347642739.250465]
