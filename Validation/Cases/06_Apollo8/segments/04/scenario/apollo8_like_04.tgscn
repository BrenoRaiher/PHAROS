inertia = { ixx_kgm2 = 23780.194828572461, iyy_kgm2 = 34679.450791668161, izz_kgm2 = 36661.133694049204, ixy_kgm2 = 0.0, ixz_kgm2 = 0.0, iyz_kgm2 = 0.0 }


[[thrusters]]
