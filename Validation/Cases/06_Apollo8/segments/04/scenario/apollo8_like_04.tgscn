format = "TGSCN"
generator = "Apollo 8 current PHAROS reconstruction, 2026-09-09"

[scenario]
name = "Apollo 8 second midcourse controlled maneuver"
start_utc = "1968-12-24T01:49:55.000Z"
end_mode = "final_utc"
final_utc = "1968-12-24T01:51:07.800Z"
integrator = "adaptive_dormand_prince_54"
maximum_integrator_step_seconds = 0.25
initial_integrator_step_seconds = 0.10000000000000001
absolute_tolerance = 1.0e-5
relative_tolerance = 1.0e-12
output_mode = "fixed_interval"
output_step_seconds = 0.10000000000000001
maximum_integration_steps = 5000000
maximum_output_samples = 1000000
mass_flow_convention = "thrust_includes_exhaust_momentum"

[initial_state]
position_icrf_m = [-6122369643.7963276, 134679377559.55165, 58383166296.101189]
velocity_icrf_mps = [-29365.407819406966, -1607.0677095694782, -915.9867124905868]
attitude_body_to_icrf = [0.42501839675372927, -0.28239372494993009, -0.37254514659264332, 0.77512789930440429]
angular_velocity_body_radps = [-1.6428512692453371e-05, 0.00023270390759043229, -0.00027209955483252951]

[[components]]
id = "a8000001-0000-0000-0000-000000000001"
name = "Apollo 8 CSM dry structure"
initial_mass_kg = 13000
minimum_mass_kg = 13000
variable_mass = false
local_center_of_mass_m = [0.0, 0.0, 0.0]
origin_body_m = [0.0, 0.0, 0.0]
component_to_body = [1.0, 0.0, 0.0, 0.0]
parent_component = ""
parent_anchor_m = [0.0, 0.0, 0.0]
child_anchor_m = [0.0, 0.0, 0.0]
child_to_parent_zero_orientation = [1.0, 0.0, 0.0, 0.0]
dofs = []
inertia = { ixx_kgm2 = 22215.393185514, iyy_kgm2 = 70663.24265724, izz_kgm2 = 72245.988780387997, ixy_kgm2 = -1592.9336260196501, ixz_kgm2 = -148.99889359027301, iyz_kgm2 = 4293.8772061924201 }

[[components]]
id = "a8000002-0000-0000-0000-000000000002"
name = "Propellant and consumables pool"
initial_mass_kg = 15642.161093004914
minimum_mass_kg = 100.0
variable_mass = true
local_center_of_mass_m = [0.0, 0.0, 0.0]
origin_body_m = [0.0, 0.0, 0.0]
component_to_body = [1.0, 0.0, 0.0, 0.0]
parent_component = "Apollo 8 CSM dry structure"
