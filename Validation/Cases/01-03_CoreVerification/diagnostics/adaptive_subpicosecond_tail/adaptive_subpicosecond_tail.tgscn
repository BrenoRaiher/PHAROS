format = "TGSCN"
generator = "Fourth-update independent scheduler code review"

[scenario]
name = "Adaptive integrator sub-picosecond physical-state tail"
start_utc = "2030-01-01T00:00:00Z"
end_mode = "duration"
duration_seconds = 0.0000000000005
integrator = "adaptive_dormand_prince_54"
maximum_integrator_step_seconds = 0.0000000000005
initial_integrator_step_seconds = 0.0000000000005
absolute_tolerance = 1e-15
relative_tolerance = 1e-15
output_mode = "every_integrator_step"
output_step_seconds = 1
maximum_integration_steps = 100
maximum_output_samples = 100

[initial_state]
position_icrf_m = [0, 0, 0]
velocity_icrf_mps = [1, 2, 3]
attitude_body_to_icrf = [1, 0, 0, 0]
angular_velocity_body_radps = [0, 0, 0]

[[components]]
id = "11111111-1111-1111-1111-111111111111"
name = "Bus"
initial_mass_kg = 100
minimum_mass_kg = 100
variable_mass = false
local_center_of_mass_m = [0, 0, 0]
origin_body_m = [0, 0, 0]
component_to_body = [1, 0, 0, 0]
parent_component = ""
parent_anchor_m = [0, 0, 0]
child_anchor_m = [0, 0, 0]
child_to_parent_zero_orientation = [1, 0, 0, 0]
dofs = []
inertia = { ixx_kgm2 = 20, iyy_kgm2 = 25, izz_kgm2 = 30, ixy_kgm2 = 0, ixz_kgm2 = 0, iyz_kgm2 = 0 }

[control]
mode = "none"

[gravity]
include_first_post_newtonian_correction = false
bodies = []

[srp]
enabled = false

[atmosphere]
enabled = false

[aerodynamics]
enabled = false
