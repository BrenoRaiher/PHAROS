format = "TGSCN"
generator = "TGSimCore validation workspace generator"

[scenario]
name = "Case 3.2/3.3 - Earth umbra eclipse on"
start_utc = "2030-01-01T00:00:00Z"
end_mode = "duration"
duration_seconds = 1
integrator = "fixed_step_rk4"
maximum_integrator_step_seconds = 0.01
initial_integrator_step_seconds = 0.0025000000000000001
absolute_tolerance = 1.0000000000000001e-05
relative_tolerance = 9.9999999999999998e-13
output_mode = "fixed_interval"
output_step_seconds = 0.10000000000000001
maximum_integration_steps = 5000000
maximum_output_samples = 1000000

[initial_state]
position_icrf_m = [-25935885628.783314, 132924487779.00117, 57625687904.769012]
velocity_icrf_mps = [-29820.331992312353, -4922.2653856068073, -2134.5853600038868]
attitude_body_to_icrf = [0.76707666524790685, 0, 0.2551573483385145, -0.58863241264902222]
angular_velocity_body_radps = [0, 0, 0]

[[components]]
id = "11111111-1111-1111-1111-111111111111"
name = "Bus"
initial_mass_kg = 100
minimum_mass_kg = 100
variable_mass = false
local_center_of_mass_m = [0, 0, 0]
origin_body_m = [0, 0, 0]
component_to_body = [1.0, 0.0, 0.0, 0.0]
parent_component = ""
parent_anchor_m = [0, 0, 0]
child_anchor_m = [0, 0, 0]
child_to_parent_zero_orientation = [1.0, 0.0, 0.0, 0.0]
dofs = []
inertia = { ixx_kgm2 = 10, iyy_kgm2 = 10, izz_kgm2 = 10, ixy_kgm2 = 0, ixz_kgm2 = 0, iyz_kgm2 = 0 }

[control]
mode = "none"

[gravity]
include_first_post_newtonian_correction = false

[[gravity.bodies]]
catalog_key = "Sun"
gravity_enabled = false
automatic_activation_radius_m = 0.0
barycenter_resolution_radius_m = 0.0
harmonic_model_csv_file = ""
maximum_harmonic_degree = 0

[[gravity.bodies]]
catalog_key = "EarthMoonBarycenter"
gravity_enabled = false
automatic_activation_radius_m = 0.0
barycenter_resolution_radius_m = 0.0
harmonic_model_csv_file = ""
maximum_harmonic_degree = 0

[[gravity.bodies]]
catalog_key = "Earth"
gravity_enabled = false
automatic_activation_radius_m = 0.0
barycenter_resolution_radius_m = 0.0
harmonic_model_csv_file = ""
maximum_harmonic_degree = 0

[srp]
enabled = true
sun_body = "Sun"
pressure_at_one_au_pa = 4.5391e-6
compute_eclipse = true
occulting_bodies = ["Earth"]
compute_component_shadows = false
global_fallback_optics = { absorption = 1.0, specular_reflection = 0.0, diffuse_reflection = 0.0 }

[[srp.facets]]
name = "Absorbing plate"
component_id = "11111111-1111-1111-1111-111111111111"
component_name = "Bus"
stable_triangle_index = 0
logical_region = "none"
vertex0_component_m = [0, -1, -0.66666666666666663]
vertex1_component_m = [0, 1, -0.66666666666666663]
vertex2_component_m = [0, 0, 1.3333333333333333]
optics = { absorption = 1.0, specular_reflection = 0.0, diffuse_reflection = 0.0 }

[atmosphere]
enabled = false

[aerodynamics]
enabled = false
