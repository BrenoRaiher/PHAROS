name = "Articulated Surface Beta"
initial_mass_kg = 1.0
minimum_mass_kg = 1.0
variable_mass = false
local_center_of_mass_m = [0.0, 0.0, 0.0]
origin_body_m = [0.0, 0.0, 0.0]
