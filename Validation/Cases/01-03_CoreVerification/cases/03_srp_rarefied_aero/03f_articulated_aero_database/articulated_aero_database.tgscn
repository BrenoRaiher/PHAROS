format = "TGSCN"
generator = "PHAROS Case 3 articulated-aerodynamics validation"

[scenario]
name = "Case 3.8 - three-DOF aerodynamic-database interpolation"
start_utc = "2030-01-01T00:00:00Z"
end_mode = "duration"
duration_seconds = 0.001
integrator = "fixed_step_rk4"
maximum_integrator_step_seconds = 0.0001
initial_integrator_step_seconds = 0.0001
absolute_tolerance = 1.0e-8
relative_tolerance = 1.0e-12
output_mode = "fixed_interval"
output_step_seconds = 0.001
maximum_integration_steps = 100000
maximum_output_samples = 100

[initial_state]
position_icrf_m = [-25928411291.503281, 132886411414.21767, 57615760894.690384]
velocity_icrf_mps = [-31238.825475460482, 2950.971463387179, -2130.3713465340547]
attitude_body_to_icrf = [0.64136019408612943, 0.0011219380751209239, 0.00093148638276311247, 0.76723853854578805]
angular_velocity_body_radps = [0.0, 0.0, 0.0]

[[components]]
id = "61000000-0000-0000-0000-000000000001"
name = "Bus"
initial_mass_kg = 100.0
minimum_mass_kg = 100.0
variable_mass = false
local_center_of_mass_m = [0.0, 0.0, 0.0]
origin_body_m = [0.0, 0.0, 0.0]
component_to_body = [1.0, 0.0, 0.0, 0.0]
parent_component = ""
parent_anchor_m = [0.0, 0.0, 0.0]
child_anchor_m = [0.0, 0.0, 0.0]
child_to_parent_zero_orientation = [1.0, 0.0, 0.0, 0.0]
dofs = []
inertia = { ixx_kgm2 = 10.0, iyy_kgm2 = 10.0, izz_kgm2 = 10.0, ixy_kgm2 = 0.0, ixz_kgm2 = 0.0, iyz_kgm2 = 0.0 }

