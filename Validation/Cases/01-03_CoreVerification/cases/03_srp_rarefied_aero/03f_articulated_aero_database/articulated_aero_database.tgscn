  { id = "61100000-0000-0000-0000-000000000001", name = "Alpha Deflection", motion = "rotation", axis = [1.0, 0.0, 0.0], initial_coordinate = 11.459155902616466, initial_rate = 0.0, minimum_coordinate = -28.64788975654116, maximum_coordinate = 28.64788975654116, maximum_absolute_rate = 30.0, maximum_absolute_effort = 1.0 }
]
