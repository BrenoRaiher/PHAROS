format = "TGSCN"
generator = "Continuous JWST mission validation"

[scenario]
name = "JWST CONTINUOUS POST_INSERTION_L2_COAST"
start_utc = "2022-01-24T19:04:56.648Z"
end_mode = "final_utc"
final_utc = "2022-02-01T00:00:00Z"
integrator = "adaptive_dormand_prince_54"
maximum_integrator_step_seconds = 120
initial_integrator_step_seconds = 1
absolute_tolerance = 1.0e-5
relative_tolerance = 1.0e-12
output_mode = "fixed_interval"
output_step_seconds = 1800
maximum_integration_steps = 5000000
maximum_output_samples = 1000000

[initial_state]
position_icrf_m = [-84973591099.706146, 113156968739.40591, 48629631099.690666]
velocity_icrf_mps = [-25193.508776984119, -15485.062296114846, -6665.8797945639653]
