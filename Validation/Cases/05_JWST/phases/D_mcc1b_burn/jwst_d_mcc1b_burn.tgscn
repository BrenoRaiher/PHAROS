format = "TGSCN"
generator = "Continuous JWST mission validation"

[scenario]
name = "JWST CONTINUOUS MCC1B_BURN"
start_utc = "2021-12-28T00:20:00Z"
end_mode = "final_utc"
final_utc = "2021-12-28T00:29:27.240Z"
integrator = "adaptive_dormand_prince_54"
maximum_integrator_step_seconds = 2
initial_integrator_step_seconds = 1
absolute_tolerance = 1.0e-5
relative_tolerance = 1.0e-12
output_mode = "fixed_interval"
output_step_seconds = 1
maximum_integration_steps = 5000000
maximum_output_samples = 1000000

[initial_state]
position_icrf_m = [-17082165785.835543, 135049657970.07437, 58400255605.694885]
velocity_icrf_mps = [-30273.881110087699, -1901.7328237268018, -1302.664591652484]
