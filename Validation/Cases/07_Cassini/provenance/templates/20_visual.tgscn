format = "TGSCN"
format_version = 1
generator = "Cassini TCM-17 through Saturn orbit insertion continuous reconstruction, 2026-08-27"

[scenario]
name = "Cassini-like mission: Saturn orbit insertion through the reconstructed burn endpoint (visual-appearance variant)"
start_utc = "2004-07-01T01:12:08.000Z"
end_mode = "final_utc"
final_utc = "2004-07-01T02:48:28.250Z"
integrator = "adaptive_dormand_prince_54"
maximum_integrator_step_seconds = 10
initial_integrator_step_seconds = 10.0
absolute_tolerance = 1.0e-5
relative_tolerance = 1.0e-12
output_mode = "fixed_interval"
output_step_seconds = 10
maximum_integration_steps = 5000000
maximum_output_samples = 1000000
mass_flow_convention = "thrust_includes_exhaust_momentum"

[initial_state]
position_icrf_m = [-383392449529.65088, 1192568027944.0825, 509143127925.69324]
velocity_icrf_mps = [-1221.2063882169916, 19987.568381026151, 1541.3300866751551]
attitude_body_to_icrf = [-0.23222910019084708, 0.52240659512213505, -0.74816368780134401, 0.33676711634739559]
angular_velocity_body_radps = [-7.7958341770705732e-53, 8.5469309382613137e-47, 5.3538604830438193e-45]


[[components]]
id = "ca550001-0000-0000-0000-000000000001"
