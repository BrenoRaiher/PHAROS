format = "TGSCN"
format_version = 1
generator = "Cassini TCM-17 through Saturn orbit insertion continuous reconstruction, 2026-08-27"

[scenario]
name = "Cassini-like mission: TCM-19a to immediately before TCM-19b"
start_utc = "2003-09-10T20:00:00.000Z"
end_mode = "final_utc"
final_utc = "2003-10-02T04:00:00.000Z"
integrator = "adaptive_dormand_prince_54"
maximum_integrator_step_seconds = 1800
initial_integrator_step_seconds = 10.0
absolute_tolerance = 1.0e-5
relative_tolerance = 1.0e-12
output_mode = "fixed_interval"
output_step_seconds = 900
maximum_integration_steps = 5000000
maximum_output_samples = 1000000
mass_flow_convention = "thrust_includes_exhaust_momentum"

[initial_state]
position_icrf_m = [-239702808751.56778, 1159919286908.9456, 493936677016.14575]
velocity_icrf_mps = [-6006.7827905113436, 2055.7318871771486, 942.88495198767225]
attitude_body_to_icrf = [0.12327974613517935, 0.59217705221968253, 0.65726938746534036, 0.44958357990276887]
angular_velocity_body_radps = [2.3897459169302616e-10, 1.9149292789568461e-08, -1.7722569272963105e-08]

[[components]]
id = "ca550001-0000-0000-0000-000000000001"
name = "Cassini-Huygens dry spacecraft"
initial_mass_kg = 2523
minimum_mass_kg = 2523
variable_mass = false
local_center_of_mass_m = [0.0, 0.0, 0.0]
origin_body_m = [0.0, 0.0, 0.0]
component_to_body = [1.0, 0.0, 0.0, 0.0]
parent_component = ""
parent_anchor_m = [0.0, 0.0, 0.0]
child_anchor_m = [0.0, 0.0, 0.0]
child_to_parent_zero_orientation = [1.0, 0.0, 0.0, 0.0]
dofs = []
inertia = { ixx_kgm2 = 5046, iyy_kgm2 = 12249, izz_kgm2 = 12249, ixy_kgm2 = 0.0, ixz_kgm2 = 0.0, iyz_kgm2 = 0.0 }

[[components]]
id = "ca550002-0000-0000-0000-000000000002"
name = "Cassini propellant inventory"
initial_mass_kg = 2085.0226069390783
minimum_mass_kg = 0.0
variable_mass = true
local_center_of_mass_m = [0.0, 0.0, 0.0]
origin_body_m = [0.0, 0.0, 0.0]
component_to_body = [1.0, 0.0, 0.0, 0.0]
parent_component = "Cassini-Huygens dry spacecraft"
parent_anchor_m = [0.0, 0.0, 0.0]
child_anchor_m = [0.0, 0.0, 0.0]
child_to_parent_zero_orientation = [1.0, 0.0, 0.0, 0.0]
dofs = []
inertia = { ixx_kgm2 = 4170.3185877613287, iyy_kgm2 = 10114.833677297214, izz_kgm2 = 10114.833677297214, ixy_kgm2 = 0, ixz_kgm2 = 0, iyz_kgm2 = 0 }

[[thrusters]]
name = "TCM-19a Effective RCS"
mode = "commanded"
mount_component = "Cassini-Huygens dry spacecraft"
propellant_component = "Cassini propellant inventory"
application_point_component_m = [0.0, 0.0, 0.0]
direction_component = [1.0, 0.0, 0.0]
ignition_time_mode = "elapsed"
ignition_elapsed_seconds = 0.0
never_shuts_down = false
shutdown_time_mode = "elapsed"
shutdown_elapsed_seconds = 1843200
maximum_thrust_n = 4

[[thrusters]]
name = "Effective Accumulated Cruise RCS Correction"
mode = "commanded"
mount_component = "Cassini-Huygens dry spacecraft"
propellant_component = "Cassini propellant inventory"
application_point_component_m = [0.0, 0.0, 0.0]
direction_component = [1.0, 0.0, 0.0]
ignition_time_mode = "elapsed"
ignition_elapsed_seconds = 0.0
never_shuts_down = false
shutdown_time_mode = "elapsed"
shutdown_elapsed_seconds = 1843200
maximum_thrust_n = 4

[[reaction_wheels]]
name = "X Reaction Wheel"
mount_component = "Cassini-Huygens dry spacecraft"
axis_component = [1, 0, 0]
initial_momentum_nms = 0.0002712542061107499
maximum_absolute_momentum_nms = 36.0

[[reaction_wheels]]
name = "Y Reaction Wheel"
mount_component = "Cassini-Huygens dry spacecraft"
axis_component = [0, 1, 0]
initial_momentum_nms = -0.0003404014863298664
maximum_absolute_momentum_nms = 36.0

[[reaction_wheels]]
name = "Z Reaction Wheel"
mount_component = "Cassini-Huygens dry spacecraft"
axis_component = [0, 0, 1]
initial_momentum_nms = 0.0013789352797396895
maximum_absolute_momentum_nms = 36.0

[control]
mode = "compiled_user_controller"
unreal_controller_id = ""
controller_dll_file = "../controllers/CassiniSaturnArrivalController16.dll"
    
[gravity]
include_first_post_newtonian_correction = true

[[gravity.bodies]]
catalog_key = "Sun"
gravity_enabled = true
automatic_activation_radius_m = 0
barycenter_resolution_radius_m = 0
harmonic_model_csv_file = ""
maximum_harmonic_degree = 0

[[gravity.bodies]]
catalog_key = "MercuryBarycenter"
