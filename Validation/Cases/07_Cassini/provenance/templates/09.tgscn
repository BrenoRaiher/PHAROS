format = "TGSCN"
format_version = 1
generator = "Cassini TCM-9 to pre-TCM-13 continuous Earth-flyby reconstruction, 2026-08-26"

[scenario]
name = "Cassini-like mission: finite TCM-11 to immediately before TCM-12"
start_utc = "1999-08-02T21:30:00.000Z"
end_mode = "final_utc"
final_utc = "1999-08-11T15:30:00.000Z"
integrator = "adaptive_dormand_prince_54"
maximum_integrator_step_seconds = 300
initial_integrator_step_seconds = 10.0
absolute_tolerance = 1.0e-5
relative_tolerance = 1.0e-12
output_mode = "fixed_interval"
output_step_seconds = 300
maximum_integration_steps = 5000000
maximum_output_samples = 1000000
mass_flow_convention = "thrust_includes_exhaust_momentum"

[initial_state]
position_icrf_m = [77888606757.955444, -97417318565.142197, -41350385742.375488]
velocity_icrf_mps = [37003.731095521478, 9824.8547968789135, 3631.4402021039714]
attitude_body_to_icrf = [0.20565804453870648, 0.83345401373502626, 0.43532186329128519, 0.27120850105793842]
angular_velocity_body_radps = [-3.8592346149202485e-14, 8.3475624319534784e-09, -8.0846587975973229e-09]

[[components]]
id = "ca550001-0000-0000-0000-000000000001"
name = "Cassini-Huygens dry spacecraft"
initial_mass_kg = 2523
minimum_mass_kg = 2523
variable_mass = false
local_center_of_mass_m = [0.0, 0.0, 0.0]
origin_body_m = [0.0, 0.0, 0.0]
component_to_body = [1.0, 0.0, 0.0, 0.0]
parent_component = ""
parent_anchor_m = [0.0, 0.0, 0.0]
child_anchor_m = [0.0, 0.0, 0.0]
child_to_parent_zero_orientation = [1.0, 0.0, 0.0, 0.0]
dofs = []
inertia = { ixx_kgm2 = 5046, iyy_kgm2 = 12249, izz_kgm2 = 12249, ixy_kgm2 = 0.0, ixz_kgm2 = 0.0, iyz_kgm2 = 0.0 }

[[components]]
id = "ca550002-0000-0000-0000-000000000002"
name = "Cassini propellant inventory"
initial_mass_kg = 2179.365128024916
minimum_mass_kg = 0.0
variable_mass = true
local_center_of_mass_m = [0.0, 0.0, 0.0]
origin_body_m = [0.0, 0.0, 0.0]
component_to_body = [1.0, 0.0, 0.0, 0.0]
parent_component = "Cassini-Huygens dry spacecraft"
parent_anchor_m = [0.0, 0.0, 0.0]
child_anchor_m = [0.0, 0.0, 0.0]
child_to_parent_zero_orientation = [1.0, 0.0, 0.0, 0.0]
dofs = []
inertia = { ixx_kgm2 = 4359.0159994781825, iyy_kgm2 = 10572.506848947407, izz_kgm2 = 10572.506848947407, ixy_kgm2 = 0, ixz_kgm2 = 0, iyz_kgm2 = 0 }

[[thrusters]]
name = "TCM-11 Effective Main Engine"
mode = "commanded"
mount_component = "Cassini-Huygens dry spacecraft"
propellant_component = "Cassini propellant inventory"
application_point_component_m = [0.0, 0.0, 0.0]
direction_component = [1.0, 0.0, 0.0]
ignition_time_mode = "elapsed"
ignition_elapsed_seconds = 0.0
never_shuts_down = false
shutdown_time_mode = "elapsed"
shutdown_elapsed_seconds = 756000
maximum_thrust_n = 500

[[reaction_wheels]]
name = "X Reaction Wheel"
mount_component = "Cassini-Huygens dry spacecraft"
axis_component = [1, 0, 0]
initial_momentum_nms = 0.00053161414200538252
maximum_absolute_momentum_nms = 36.0

[[reaction_wheels]]
name = "Y Reaction Wheel"
mount_component = "Cassini-Huygens dry spacecraft"
axis_component = [0, 1, 0]
initial_momentum_nms = -0.00025706752610772589
maximum_absolute_momentum_nms = 36.0

[[reaction_wheels]]
name = "Z Reaction Wheel"
mount_component = "Cassini-Huygens dry spacecraft"
axis_component = [0, 0, 1]
initial_momentum_nms = 0.00097745691586313774
maximum_absolute_momentum_nms = 36.0

[control]
mode = "compiled_user_controller"
unreal_controller_id = ""
controller_dll_file = "../controllers/CassiniEarthFlybyController9.dll"

[gravity]
include_first_post_newtonian_correction = true

[[gravity.bodies]]
catalog_key = "Sun"
gravity_enabled = true
automatic_activation_radius_m = 0.0
barycenter_resolution_radius_m = 0.0
harmonic_model_csv_file = ""
maximum_harmonic_degree = 0

[[gravity.bodies]]
catalog_key = "MercuryBarycenter"
gravity_enabled = true
automatic_activation_radius_m = 0.0
barycenter_resolution_radius_m = 0.0
harmonic_model_csv_file = ""
