[srp]
enabled = true
sun_body = "Sun"
pressure_at_one_au_pa = 4.5391e-6
compute_eclipse = true
occulting_bodies = ["Earth", "Moon", "Venus"]
compute_component_shadows = false
global_fallback_optics = { absorption = 1, specular_reflection = 0, diffuse_reflection = 0.0 }

[[srp.facets]]
name = "HGA effective square triangle 0"
component_id = "ca550001-0000-0000-0000-000000000001"
component_name = "Cassini-Huygens dry spacecraft"
stable_triangle_index = 0
logical_region = "positive_x"
vertex0_component_m = [0.0, -1.7724538509055159, -1.7724538509055159]
vertex1_component_m = [0.0, 1.7724538509055159, -1.7724538509055159]
vertex2_component_m = [0.0, 1.7724538509055159, 1.7724538509055159]
optics = { absorption = 1, specular_reflection = 0, diffuse_reflection = 0.0 }

[[srp.facets]]
name = "HGA effective square triangle 1"
component_id = "ca550001-0000-0000-0000-000000000001"
component_name = "Cassini-Huygens dry spacecraft"
stable_triangle_index = 1
logical_region = "positive_x"
vertex0_component_m = [0.0, -1.7724538509055159, -1.7724538509055159]
vertex1_component_m = [0.0, 1.7724538509055159, 1.7724538509055159]
vertex2_component_m = [0.0, -1.7724538509055159, 1.7724538509055159]
optics = { absorption = 1, specular_reflection = 0, diffuse_reflection = 0.0 }

[atmosphere]
