format = "TGSCN"
generator = "TGSimCore Earth-orbit attitude-recovery validation v2"

[scenario]
name = "Earth orbit - four-wheel Sun-pointing recovery"
start_utc = "2030-01-01T00:00:00Z"
end_mode = "duration"
duration_seconds = 5926.3786155486341
integrator = "adaptive_dormand_prince_54"
maximum_integrator_step_seconds = 0.25
initial_integrator_step_seconds = 0.05
absolute_tolerance = 1.0e-8
relative_tolerance = 1.0e-11
output_mode = "fixed_interval"
output_step_seconds = 0.5
maximum_integration_steps = 10000000
maximum_output_samples = 1000000

[initial_state]
position_icrf_m = [-25921352339.544216, 132886411478.60672, 57609182786.06604]
velocity_icrf_mps = [-29820.331992312353, -260.9943945981322, 3746.4749841858206]
