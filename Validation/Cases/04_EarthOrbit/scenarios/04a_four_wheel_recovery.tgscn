[[components]]
id = "44444444-4444-4444-4444-444444444444"
name = "Propellant"
initial_mass_kg = 20.0
minimum_mass_kg = 5.0
variable_mass = true
local_center_of_mass_m = [0.0, 0.0, 0.0]
origin_body_m = [-0.5, 0.0, 0.0]
