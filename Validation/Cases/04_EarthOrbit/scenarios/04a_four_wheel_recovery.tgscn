[[thrusters]]
name = "Gimballed Disturbance Thruster"
mode = "commanded"
mount_component = "Disturbance Gimbal"
propellant_component = "Propellant"
application_point_component_m = [0, 0, 0]
direction_component = [1, 0, 0]
ignition_time_mode = "elapsed"
ignition_elapsed_seconds = 0.0
never_shuts_down = true
shutdown_time_mode = "elapsed"
shutdown_elapsed_seconds = 0.0
maximum_thrust_n = 4

[[reaction_wheels]]
name = "Tetrahedral Wheel 1"
mount_component = "Bus"
axis_component = [0.57735026918962584, 0.57735026918962584, 0.57735026918962584]
initial_momentum_nms = 0.0
maximum_absolute_momentum_nms = 50.0

[[reaction_wheels]]
name = "Tetrahedral Wheel 2"
mount_component = "Bus"
axis_component = [0.57735026918962584, -0.57735026918962584, -0.57735026918962584]
initial_momentum_nms = 0.0
maximum_absolute_momentum_nms = 50.0

[[reaction_wheels]]
name = "Tetrahedral Wheel 3"
mount_component = "Bus"
axis_component = [-0.57735026918962584, 0.57735026918962584, -0.57735026918962584]
initial_momentum_nms = 0.0
maximum_absolute_momentum_nms = 50.0

[[reaction_wheels]]
name = "Tetrahedral Wheel 4"
mount_component = "Bus"
axis_component = [-0.57735026918962584, -0.57735026918962584, 0.57735026918962584]
initial_momentum_nms = 0.0
maximum_absolute_momentum_nms = 50.0

[control]
mode = "compiled_user_controller"
unreal_controller_id = ""
controller_dll_file = "../controllers/EarthFourWheelRecoveryController.dll"

[gravity]
include_first_post_newtonian_correction = false

[[gravity.bodies]]
catalog_key = "Sun"
gravity_enabled = true
automatic_activation_radius_m = 0.0
barycenter_resolution_radius_m = 0.0
harmonic_model_csv_file = ""
maximum_harmonic_degree = 0

[[gravity.bodies]]
catalog_key = "EarthMoonBarycenter"
gravity_enabled = false
automatic_activation_radius_m = 0.0
barycenter_resolution_radius_m = 0.0
harmonic_model_csv_file = ""
maximum_harmonic_degree = 0

[[gravity.bodies]]
catalog_key = "Earth"
gravity_enabled = true
automatic_activation_radius_m = 0.0
barycenter_resolution_radius_m = 0.0
harmonic_model_csv_file = ""
maximum_harmonic_degree = 0

[[gravity.bodies]]
catalog_key = "Moon"
gravity_enabled = true
automatic_activation_radius_m = 0.0
barycenter_resolution_radius_m = 0.0
harmonic_model_csv_file = ""
maximum_harmonic_degree = 0

[srp]
enabled = true
sun_body = "Sun"
pressure_at_one_au_pa = 4.5391e-6
compute_eclipse = true
occulting_bodies = ["Earth"]
compute_component_shadows = false
global_fallback_optics = { absorption = 0.85, specular_reflection = 0.10, diffuse_reflection = 0.05 }

[[srp.facets]]
name = "Sun-facing solar array"
component_id = "22222222-2222-2222-2222-222222222222"
component_name = "Solar Panel"
stable_triangle_index = 0
logical_region = "none"
vertex0_component_m = [0.0, -2.0, -3.333333333333333]
vertex1_component_m = [0.0, 2.0, -3.333333333333333]
vertex2_component_m = [0.0, 0.0, 6.666666666666667]
optics = { absorption = 0.85, specular_reflection = 0.10, diffuse_reflection = 0.05 }

[atmosphere]
enabled = false

[aerodynamics]
enabled = false
