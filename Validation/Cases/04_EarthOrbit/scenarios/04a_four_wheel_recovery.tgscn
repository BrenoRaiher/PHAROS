name = "Solar Panel"
initial_mass_kg = 40.0
minimum_mass_kg = 40.0
variable_mass = false
local_center_of_mass_m = [0.0, 0.0, 0.0]
origin_body_m = [1.5, 0.0, 0.0]
component_to_body = [1.0, 0.0, 0.0, 0.0]
parent_component = "Bus"
parent_anchor_m = [1.5, 0.0, 0.0]
child_anchor_m = [0.0, 0.0, 0.0]
child_to_parent_zero_orientation = [1.0, 0.0, 0.0, 0.0]
dofs = []
inertia = { ixx_kgm2 = 15.0, iyy_kgm2 = 80.0, izz_kgm2 = 80.0, ixy_kgm2 = 0.0, ixz_kgm2 = 0.0, iyz_kgm2 = 0.0 }

[[components]]
id = "33333333-3333-3333-3333-333333333333"
name = "Disturbance Gimbal"
initial_mass_kg = 5.0
minimum_mass_kg = 5.0
variable_mass = false
local_center_of_mass_m = [0.0, 0.0, 0.0]
origin_body_m = [2.4, -1.1, 0.8]
component_to_body = [1.0, 0.0, 0.0, 0.0]
parent_component = "Bus"
parent_anchor_m = [2.4, -1.1, 0.8]
child_anchor_m = [0.0, 0.0, 0.0]
child_to_parent_zero_orientation = [1.0, 0.0, 0.0, 0.0]
dofs = [
  { id = "33333333-3333-3333-3333-333333333334", name = "Disturbance Yaw", motion = "rotation", axis = [0.0, 0.0, 1.0], initial_coordinate = 0, initial_rate = 0, minimum_coordinate = -68.754935415698782, maximum_coordinate = 68.754935415698782, maximum_absolute_rate = 114.59155902616465, maximum_absolute_effort = 20.0 },
  { id = "33333333-3333-3333-3333-333333333335", name = "Disturbance Pitch", motion = "rotation", axis = [0.0, 1.0, 0.0], initial_coordinate = 0, initial_rate = 0, minimum_coordinate = -68.754935415698782, maximum_coordinate = 68.754935415698782, maximum_absolute_rate = 114.59155902616465, maximum_absolute_effort = 20.0 }
]
