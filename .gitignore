# Only maintained project files and contributor documentation belong in Git.
/*
!/.gitignore
!/.gitattributes
!/.vsconfig
!/.github/
!/PHAROS.uproject
!/LICENSE
!/README.md
!/CITATION.cff
!/CONTRIBUTING.md
!/SECURITY.md
!/Build/
!/Config/
!/Content/
!/ControllerSDK/
!/Docs/
!/Source/
!/Tools/
!/Validation/
!/PHAROS-Reproducibility-Bundle.zip

# Generated output, local IDE state, saves, crash dumps, and caches.
**/.vs/
**/.vscode/
**/.idea/
**/Binaries/
**/DerivedDataCache/
**/Intermediate/
**/Saved/
**/bin/
**/obj/
**/out/
/Source/TGSimCore/build/
**/cmake-build-*/
**/CMakeFiles/
**/CMakeCache.txt
**/__pycache__/
*.sln
*.suo
*.user
*.userosscache
*.sln.docstates
*.VC.db
*.VC.VC.opendb
*.obj
*.pdb
*.ilk
*.exp
*.dmp
*.log
*.sav
*.lnk
*.py[cod]
*.tmp
*.download
*.bak
*.swp
Thumbs.db
[Dd]esktop.ini
.DS_Store

# Reinstallable compiler binaries are downloaded with a pinned checksum.
/Build/Receipts/
/Build/ControllerToolchain/Win64/
/Content/Developers/
/Content/Collections/
/Docs/Archive/

# Private permissions, credentials, and signing material never belong in Git.
**/PrivatePermissions/
/Docs/Legal/Private/
.env
.env.*
!.env.example
*.pfx
*.p12
*.key
*.pem

# Only the vendored CSPICE library is a source-distribution dependency.
*.dll
*.exe
*.lib
!Source/ThirdParty/CSPICE/Lib/Win64/cspice.lib

/Validation/**/build/
/Validation/Support/Runtime/controller_build/
/Validation/Support/Runtime/verification_build/
/Validation/scratch/

# Optional source artwork restored by the evidence bundle.
