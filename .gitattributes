*.ico filter=lfs diff=lfs merge=lfs -text
*.stl filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text

# Frozen runtimes, mission reference products, and numerical histories.
Validation/**/*.exe filter=lfs diff=lfs merge=lfs -text
Validation/**/*.dll filter=lfs diff=lfs merge=lfs -text
Validation/**/*_solution.csv filter=lfs diff=lfs merge=lfs -text
Validation/**/*.pdf filter=lfs diff=lfs merge=lfs -text
Validation/**/*.zip filter=lfs diff=lfs merge=lfs -text

# Preserve recorded evidence byte for byte across checkouts.
Validation/** -text
